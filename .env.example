# =============================================================================
# MyBooking — Milestone IdP & BFF Environment Template (.env.example)
# Copy to .env for local development (`cp .env.example .env`).
# NEVER commit .env or real production secrets/KEKs to version control (T-13).
# =============================================================================

# --- 1. Application PostgreSQL 16 (app-db on 127.0.0.1:5433 -> 5432) ---
DB_HOST_PORT=5433
DB_NAME=mybooking
DB_USER=mybooking
DB_PASS=dev_only_app_db_password_change_me
DB_URL=jdbc:postgresql://127.0.0.1:5433/mybooking

# --- 2. Dedicated Keycloak PostgreSQL 16 (keycloak-db, internal kc_db_net only) ---
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASS=dev_only_kc_db_password_change_me

# --- 3. Keycloak 26.4.0 Identity Provider (127.0.0.1:8180 -> 8080) ---
KC_HOST_PORT=8180
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev_only_kc_admin_password_change_me
KC_CLIENT_SECRET_BFF=dev_only_bff_client_secret_change_me

# Parameterized Keycloak Client URLs & Realm Controls (dev defaults; production uses explicit https:// URLs and KC_SSL_REQUIRED=ALL)
KC_SSL_REQUIRED=external
KC_BFF_REDIRECT_URI=http://localhost:3000/api/auth/callback
KC_BFF_WEB_ORIGIN=http://localhost:3000
KC_BFF_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/*
KC_BFF_BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:3000/api/auth/backchannel-logout
# Dev-only seed fixture toggle (NEVER set KC_IMPORT_DEV_USERS=true in production)
KC_IMPORT_DEV_USERS=true
KC_DEV_SEED_PASSWORD=Pass123@Perform!

# --- 4. Spring Boot Resource Server JWKS & Issuer Validation ---
# Spring Boot is excluded from bff_idp_net and kc_db_net; it fetches public JWKS
# via the canonical Keycloak issuer endpoint (HTTPS in non-dev; 127.0.0.1:8180 in local dev).
APP_SECURITY_ISSUER_URI=http://127.0.0.1:8180/realms/mybooking
APP_SECURITY_JWK_SET_URI=http://127.0.0.1:8180/realms/mybooking/protocol/openid-connect/certs

# --- 5. BFF Redis 7 Session Store (127.0.0.1:6379, persistence disabled) ---
REDIS_HOST_PORT=6379
REDIS_ACL_USER=bff_app
REDIS_PASSWORD=dev_only_redis_password_change_me
REDIS_URL=redis://bff_app:dev_only_redis_password_change_me@127.0.0.1:6379/0

# --- 6. Next.js BFF Envelope Encryption (AES-256-GCM) & Routing ---
# Base64-encoded 32-byte (256-bit) development-only KEK. Rotate via keyVersion in prod KMS/Vault.
BFF_MASTER_KEK_JSON={"currentVersion":1,"keys":{"1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}}
OIDC_TXN_SECRET=dev_only_32_byte_oidc_txn_secret_change_me
APP_BASE_URL=http://localhost:3000
BACKEND_INTERNAL_BASE_URL=http://127.0.0.1:8080
